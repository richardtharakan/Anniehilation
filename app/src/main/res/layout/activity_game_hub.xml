<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_app_gradient"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/btnHubBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back to home" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GAME ARCADE"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CHOOSE YOUR NEXT ADVENTURE"
                android:textColor="#48EBFF"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="04 / 06"
            android:textColor="#B8D7E8"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:scrollbars="none"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ROW 1: ANNIEHILATION + CHESS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="168dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/tileAnniehilation"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="7dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:adjustViewBounds="true"
                        android:src="@drawable/anniehilation_logo"
                        android:contentDescription="Original Anniehilation logo"
                        android:scaleType="fitCenter" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Anniehilation"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Adventure platformer"
                        android:textColor="#B8D7E8"
                        android:textSize="10sp"
                        android:gravity="center" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PLAY NOW"
                        android:textColor="#48EBFF"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-bold"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileChess"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="7dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView android:layout_width="76dp" android:layout_height="76dp"
                        android:contentDescription="Annie versus Queen Berthu Royal Chess emblem"
                        android:scaleType="fitCenter"
                        android:src="@drawable/royal_chess_faceoff_logo" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Royal Chess" android:textColor="#FFFFFF" android:textSize="18sp"
                        android:fontFamily="sans-serif-black" android:gravity="center" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Play Berthu or two players" android:textColor="#B8D7E8" android:textSize="10sp"
                        android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PLAY NOW" android:textColor="#48EBFF" android:textSize="10sp"
                        android:fontFamily="sans-serif-bold" android:layout_marginTop="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ROW 2: ZIP TRAIL + ANNIENVASION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="168dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/tileZip"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="7dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView android:layout_width="76dp" android:layout_height="76dp"
                        android:contentDescription="Berthu orange tabby logo for Zip Trail"
                        android:scaleType="fitCenter"
                        android:src="@drawable/berthu_face_logo" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="ZIP TRAIL" android:textColor="#FFFFFF" android:textSize="18sp"
                        android:fontFamily="sans-serif-black" android:gravity="center" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Berthu number-link puzzle" android:textColor="#B8D7E8" android:textSize="10sp"
                        android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PLAY NOW" android:textColor="#48EBFF" android:textSize="10sp"
                        android:fontFamily="sans-serif-bold" android:layout_marginTop="3dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileGame04"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="7dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:src="@drawable/annienvasion_annie_badge"
                        android:contentDescription="Annienvasion miniature army game logo"
                        android:scaleType="fitCenter" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="ANNIENVASION" android:textColor="#FFFFFF" android:textSize="16sp"
                        android:fontFamily="sans-serif-black" android:gravity="center" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Miniature army conquest" android:textColor="#B8D7E8" android:textSize="10sp"
                        android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PLAY NOW" android:textColor="#48EBFF" android:textSize="10sp"
                        android:fontFamily="sans-serif-bold" android:layout_marginTop="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ROW 3: FUTURE GAMES 05 + 06 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="168dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/tileGame05"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="7dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🚀" android:textSize="40sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="GAME 05" android:textColor="#FFFFFF" android:textSize="17sp"
                        android:fontFamily="sans-serif-black" android:gravity="center" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Coming attraction" android:textColor="#B8D7E8" android:textSize="10sp"
                        android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="COMING SOON" android:textColor="#FFD27C" android:textSize="10sp"
                        android:fontFamily="sans-serif-bold" android:layout_marginTop="3dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileGame06"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="7dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🎯" android:textSize="40sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="GAME 06" android:textColor="#FFFFFF" android:textSize="17sp"
                        android:fontFamily="sans-serif-black" android:gravity="center" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Coming attraction" android:textColor="#B8D7E8" android:textSize="10sp"
                        android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="COMING SOON" android:textColor="#FFD27C" android:textSize="10sp"
                        android:fontFamily="sans-serif-bold" android:layout_marginTop="3dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center"
        android:text="MORE GAMES. MORE ADVENTURES."
        android:textColor="#7FAEC6"
        android:textSize="10sp"
        android:letterSpacing="0.12"
        android:fontFamily="sans-serif-medium" />
</LinearLayout>
